# Copy to infra/.env on the EC2 instance. That file is git-ignored; never commit real values.
# Generate each value with: openssl rand -hex 32
#
# PostgreSQL only reads the passwords when its data volume is created. To change them later,
# change them inside the database too.

AWS_REGION=ap-southeast-1

JWT_SECRET=
POSTGRES_PASSWORD=
WALLET_DB_PASSWORD=
TRANSFER_DB_PASSWORD=
LEDGER_DB_PASSWORD=
